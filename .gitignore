# pickles in outputs/ stay tracked.
outputs/*_raw_network_data_*.pkl
outputs/models/

# Overleaf-synced report repo -- version-controlled separately via its own git remote
report/

# Supervisor-meeting scratch assets (large GIFs, unrelated PDFs) -- not part of the reproducible pipeline
presentation/

# Python bytecode cache
__pycache__/
*.pyc

# Jupyter checkpoints
.ipynb_checkpoints/

# Editor/workspace settings
.vscode/

# Internal documentation -- kept locally, not published on GitHub (README.md/LOGIC.md are the public-facing docs)
CLAUDE.md
COMPILED.md
docs/

# Not required on GitHub -- kept locally only
data_visualisation.ipynb
